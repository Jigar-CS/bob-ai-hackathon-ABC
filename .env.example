# PortPulse configuration template.
# Copy to .env and edit. .env is gitignored — never commit real credentials.
#
#   cp .env.example .env
#
# Every value below is optional; the defaults shown are what the app uses when
# the variable is unset.

# ─── IBM watsonx.ai / BOB Agent ──────────────────────────────────────────────
# Enables AI-written routing recommendations and intelligent chatbot replies.
# Insert your API Key below in BOB_AGENT_API_KEY (or WATSONX_API_KEY).
# If BOB_AGENT_PROJECT_ID / WATSONX_PROJECT_ID is left blank, it defaults to "bob-agent-project".
BOB_AGENT_API_KEY=
BOB_AGENT_PROJECT_ID=
BOB_AGENT_URL=
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
WATSONX_API_VERSION=2024-05-01
WATSONX_IAM_URL=https://iam.cloud.ibm.com/identity/token
WATSONX_IAM_TIMEOUT_SECONDS=10
WATSONX_REQUEST_TIMEOUT_SECONDS=60
WATSONX_MAX_RETRIES=3
WATSONX_BACKOFF_FACTOR=0.5
WATSONX_MAX_NEW_TOKENS=300
WATSONX_AUTH_COOLDOWN_SECONDS=60
WATSONX_TOKEN_EXPIRY_BUFFER_SECONDS=300

# ─── Runtime ─────────────────────────────────────────────────────────────────
# development | staging | production
# In production the app refuses to start without PORTPULSE_API_KEY and rejects
# wildcard CORS origins.
PORTPULSE_ENVIRONMENT=development
PORTPULSE_HOST=127.0.0.1
PORTPULSE_PORT=8000

# ─── Logging ─────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
PORTPULSE_LOG_LEVEL=INFO
# true emits one JSON object per line, for log aggregators.
PORTPULSE_LOG_JSON=false

# ─── Security ────────────────────────────────────────────────────────────────
# When set, upload and custom-plan endpoints require this value in the
# X-API-Key header. Leave blank for local use only.
PORTPULSE_API_KEY=
PORTPULSE_CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PORTPULSE_MAX_UPLOAD_BYTES=5242880

# ─── Planning parameters ─────────────────────────────────────────────────────
# Directory holding vessels.csv, berths.csv and alternate_ports.json.
# Defaults to the datasets bundled with the package.
# PORTPULSE_DATA_DIR=/srv/portpulse/data

# A vessel queued longer than this is treated as unplaceable and rerouted.
PORTPULSE_MAX_BERTH_WAIT_HOURS=12.0
# Incoming TEU / total berth capacity ratios that classify a 24-hour window.
PORTPULSE_CONGESTION_HIGH_RISK_RATIO=0.9
PORTPULSE_CONGESTION_MEDIUM_RISK_RATIO=0.6

# ─── watsonx.ai fan-out guards ───────────────────────────────────────────────
PORTPULSE_ROUTING_MAX_WORKERS=8
# Hard ceiling on LLM calls per request; vessels beyond it use template text.
PORTPULSE_ROUTING_MAX_LLM_CALLS=25
