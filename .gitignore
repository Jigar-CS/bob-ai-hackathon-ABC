# ── Secrets & environment ────────────────────────────────────────────────────
# Never commit real credentials. .env.example is the tracked template.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# ── Test & tooling caches ────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ── Logs & local runtime output ──────────────────────────────────────────────
# Anchored to the repo root so the packaged sample data in
# src/portpulse/data/ is NOT excluded.
/logs/
/tmp-data/
*.log

# ── Large media (link to hosted video instead) ────────────────────────────────
demo/*.mp4
demo/*.mov
demo/*.avi
demo/*.mkv

# ── OS & editor noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
